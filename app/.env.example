# Copy to app/.env and fill in. app/.env is git-ignored; never commit a key.
# These are read only by the server-side /api layer and are never sent to the browser.

DEEPSEEK_API_KEY=

# Optional. Any OpenAI-compatible endpoint works, e.g. a self-hosted DeepSeek model behind vLLM.
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional. Models for intent detection (fast, JSON) and for answers.
# DEEPSEEK_INTENT_MODEL=deepseek-flash
# DEEPSEEK_CHAT_MODEL=deepseek-flash

# Optional. "on" turns on thinking mode for answers (slower, more thorough). Intent detection never uses it.
# DEEPSEEK_THINKING=off

# Optional. Request timeout in milliseconds.
# DEEPSEEK_TIMEOUT_MS=60000

# Optional. Where the SQLite database lives.
# HORIZON_DB_PATH=data/horizon.db

# Optional. A GitHub token for Hexa repo scans: raises the rate limit (60/hour without) and allows private repos it can read.
# GITHUB_TOKEN=

# Optional. A shared secret CI uses to push test results to Hexa (POST /api/hexa/results).
# HEXA_INGEST_TOKEN=
