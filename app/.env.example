# Copy to app/.env and fill in. app/.env is git-ignored; never commit a key.
# These are read only by the server (the API inside Vite in development, server/main.ts as a service)
# and are never sent to the browser. Names keep the HORIZON_ prefix for compatibility.

# ---- Model -------------------------------------------------------------------------------------
DEEPSEEK_API_KEY=

# Optional. Any OpenAI-compatible endpoint works, e.g. a self-hosted model behind vLLM.
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional. One model for everything (default deepseek-flash), or one each for routing (fast, JSON) and answers.
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_INTENT_MODEL=deepseek-flash
# DEEPSEEK_CHAT_MODEL=deepseek-flash

# Optional. "on" turns on thinking mode for answers (slower, more thorough). Routing never uses it.
# DEEPSEEK_THINKING=off
# DEEPSEEK_TIMEOUT_MS=60000

# ---- Data on this host --------------------------------------------------------------------------
# HORIZON_DB_PATH=data/horizon.db          # the SQLite file (local disk, never a network share)
# HORIZON_FILES_DIR=data/attachments       # original uploads (attachments, App Context files)
# HORIZON_WORKSPACE=../.myworkspace        # team configuration, backlogs, manual tests

# ---- Standalone server (npm start) --------------------------------------------------------------
# HORIZON_PORT=8787
# HORIZON_HOST=127.0.0.1                   # keep local; a TLS/sign-in proxy sits in front
# HORIZON_STATIC=dist                      # the built front end; empty serves the API only
# Exactly one identity source:
# HORIZON_IDENTITY_HEADER=x-forwarded-email  # shared deployment: the header your sign-in proxy sets with the email
# HORIZON_DEV_IDENTITY=1                   # development only: trust the browser's "Sign in as" picker

# ---- Integrations --------------------------------------------------------------------------------
# A GitHub token for Hexa repo scans (raises the rate limit, allows private repos) and for pulling CI artifacts.
# GITHUB_TOKEN=

# The bearer token CI uses to push test results (POST /api/hexa/results). Per-application tokens win over the shared one.
# HEXA_INGEST_TOKEN=
# HEXA_INGEST_TOKEN_IBGM=

# The local CI runner (app/scripts/ci-runner.ts) posts to this server with HEXA_INGEST_TOKEN.
# HORIZON_URL=http://127.0.0.1:5173

# Vite development only: proxy /api to a separately running API instead of hosting it inside Vite.
# HORIZON_API_URL=http://127.0.0.1:8787
