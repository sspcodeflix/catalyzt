{
  "name": "horizon-app",
  "private": true,
  "version": "0.1.0",
  "description": "Horizon: AI Quality & Reliability Engineering. Web app.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "api": "vite-node server/main.ts",
    "build:api": "esbuild server/main.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=server-dist/main.mjs --sourcemap",
    "start": "node server-dist/main.mjs",
    "backup": "vite-node scripts/backup.ts",
    "restore-check": "vite-node scripts/restore-check.ts",
    "validate-workspace": "vite-node scripts/validate-workspace.ts",
    "load-profile": "vite-node scripts/load-profile.ts",
    "retention": "vite-node scripts/retention.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@huggingface/transformers": "^3.5.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-tabs": "^1.2.1",
    "better-sqlite3": "^11.10.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^4.5.7",
    "fflate": "^0.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@fontsource/montserrat": "^5.2.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.14.0",
    "opentype.js": "^1.3.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
